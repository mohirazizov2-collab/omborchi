
# Google Gemini AI API Key
GOOGLE_GENAI_API_KEY=your_real_key

# Firebase Configuration (Next.js handles this automatically in most cases)
NEXT_PUBLIC_FIREBASE_PROJECT_ID=studio-4209846898-d5885

# Server-only company login configuration. Never prefix these variables with NEXT_PUBLIC_.
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
SESSION_SECRET=use_a_unique_random_value_of_at_least_32_characters

# Used only by `npm run seed:company-login` for the initial local/test account.
SEED_COMPANY_SLUG=farrux-mebel
SEED_COMPANY_NAME=Farrux Mebel
SEED_USERNAME=admin
SEED_PASSWORD=123456
