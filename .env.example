
# Google Gemini AI API Key
GOOGLE_GENAI_API_KEY=your_real_key

# Firebase Configuration (Next.js handles this automatically in most cases)
NEXT_PUBLIC_FIREBASE_PROJECT_ID=studio-4209846898-d5885

# Firebase Admin SDK (server routes only)
# On Firebase App Hosting, use the runtime service account/ADC and leave credentials unset.
# For local server development, configure both values from a private service-account secret.
FIREBASE_ADMIN_PROJECT_ID=studio-4209846898-d5885
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY=
