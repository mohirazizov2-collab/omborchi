rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // AUTH
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    // ============================================================
    // SUPER ADMIN
    // ============================================================

    function isSuperAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'f2472839@gmail.com';
    }

    // ============================================================
    // ADMIN
    // ============================================================

    function isAdmin() {
      return isSuperAdmin()
        ||
        (
          isSignedIn()
          &&
          exists(
            /databases/$(database)/documents/users/$(request.auth.uid)
          )
          &&
          get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.role in [
            'Admin',
            'Super Admin',
            'SUPER_ADMIN'
          ]
        );
    }

    function isSeller() {
      return isSignedIn()
        &&
        exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        &&
        get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == 'Sotuvchi';
    }

    function isWarehouseWorker() {
      return isSignedIn()
        &&
        exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        &&
        get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == 'Omborchi';
    }

    function isAdminOrSeller() {
      return isAdmin() || isSeller();
    }

    function isAdminOrWarehouse() {
      return isAdmin() || isWarehouseWorker();
    }


    // ============================================================
    // USERS
    // ============================================================

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin() || request.auth.uid == userId;
      allow delete: if isSuperAdmin();
    }


    // ============================================================
    // PRODUCTS
    // ============================================================

    match /products/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isAdminOrSeller();
      allow delete: if isAdmin();
    }

    match /categories/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /recipes/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }


    // ============================================================
    // WAREHOUSE
    // ============================================================

    match /warehouses/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /inventory/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdminOrWarehouse();
    }

    match /inventory-audit/{docId} {
      allow read: if isAdmin();
      allow write: if isAdminOrWarehouse();
    }

    match /stockMovements/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdminOrWarehouse();
    }


    // ============================================================
    // STOCK IN
    // ============================================================

    match /stock-in/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isAdminOrWarehouse();
      allow delete: if isAdmin();
    }


    // ============================================================
    // STOCK OUT
    // ============================================================

    match /stock-out/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isAdminOrWarehouse();
      allow delete: if isAdmin();
    }


    // ============================================================
    // TRANSFERS
    // ============================================================

    match /transfers/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isAdminOrWarehouse();
      allow delete: if isAdmin();
    }


    // ============================================================
    // PRODUCTION
    // ============================================================

    match /production/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isAdminOrWarehouse();
      allow delete: if isAdmin();
    }


    // ============================================================
    // SALES
    // ============================================================

    match /sales/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isAdminOrSeller();
      allow delete: if isAdmin();
    }


    // ============================================================
    // EXPENSES
    // ============================================================

    match /expenses/{docId} {
      allow read: if isAdmin();
      allow create: if isAdminOrSeller();
      allow update, delete: if isAdmin();
    }


    // ============================================================
    // CASH
    // ============================================================

    match /cash/{docId} {
      allow read, write: if isAdmin();
    }


    // ============================================================
    // EMPLOYEES
    // ============================================================

    match /employees/{docId} {
      allow read, write: if isAdmin();
    }

    match /staff/{docId} {
      allow read, write: if isAdmin();
    }


    // ============================================================
    // REPORTS
    // ============================================================

    match /reports/{docId} {
      allow read, write: if isAdmin();
    }


    // ============================================================
    // HISTORY
    // ============================================================

    match /history/{docId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isSuperAdmin();
    }


    // ============================================================
    // AUDIT LOGS
    // ============================================================

    match /auditLogs/{docId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isSuperAdmin();
    }


    // ============================================================
    // SETTINGS
    // ============================================================

    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }


    // ============================================================
    // COUNTERS
    // ============================================================

    match /counters/{docId} {
      allow read, write: if isSignedIn();
    }


    // ============================================================
    // PROFILE
    // ============================================================

    match /profile/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || request.auth.uid == userId;
    }


    // ============================================================
    // CHAT
    // ============================================================

    match /chats/{docId} {
      allow read, write: if isSignedIn();
    }

    match /messages/{docId} {
      allow read, write: if isSignedIn();
    }


    // ============================================================
    // SUPER ADMIN — BARCHA BOSHQA COLLECTIONLAR
    // ============================================================

    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
