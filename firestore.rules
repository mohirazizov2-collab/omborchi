rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // AUTH HELPERS
    // ============================================================

    function hasAuth() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return hasAuth()
        && request.auth.token.email == 'f2472839@gmail.com';
    }

    // Kompaniya xodimi: companies/{id}/users/{uid} hujjati mavjud
    function isCompanyMember(companyId) {
      return hasAuth()
        && exists(/databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid));
    }

    // Obuna faol (active yoki trial) va muddati tugamagan
    function isActiveCompany(companyId) {
      return exists(/databases/$(database)/documents/companies/$(companyId))
        && (!('companyStatus' in get(/databases/$(database)/documents/companies/$(companyId)).data)
          || get(/databases/$(database)/documents/companies/$(companyId)).data.companyStatus == 'active')
        && get(/databases/$(database)/documents/companies/$(companyId)).data.subscriptionStatus in ['active', 'trial']
        && (
          ('subscriptionEndsAt' in get(/databases/$(database)/documents/companies/$(companyId)).data
            && get(/databases/$(database)/documents/companies/$(companyId)).data.subscriptionEndsAt is timestamp
            && get(/databases/$(database)/documents/companies/$(companyId)).data.subscriptionEndsAt > request.time)
          || ('expires_at' in get(/databases/$(database)/documents/companies/$(companyId)).data
            && get(/databases/$(database)/documents/companies/$(companyId)).data.expires_at is timestamp
            && get(/databases/$(database)/documents/companies/$(companyId)).data.expires_at > request.time)
        );
    }

    function isActiveCompanyMember(companyId) {
      return isCompanyMember(companyId)
        && get(/databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid)).data.get('status', 'active') != 'inactive'
        && isActiveCompany(companyId);
    }

    function hasModulePermission(companyId, moduleName) {
      let member = get(/databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid)).data;
      return isActiveCompanyMember(companyId)
        && ('permissions' in member)
        && member.permissions.get(moduleName, false) == true;
    }

    function hasExplicitModulePermission(companyId, moduleName) {
      let member = get(/databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid)).data;
      return isActiveCompanyMember(companyId)
        && ('permissions' in member)
        && member.permissions.get(moduleName, false) == true;
    }

    function canAccessCompanyCollection(companyId, collectionName) {
      return collectionName in ['payments', 'subscriptions', 'counters', 'chats', 'messages']
        || (collectionName == 'users' && (
          hasModulePermission(companyId, 'users')
          || hasModulePermission(companyId, 'employees')
        ))
        || (collectionName == 'accountAuditLogs' && hasModulePermission(companyId, 'users'))
        || (collectionName in ['products', 'categories'] && (
          hasModulePermission(companyId, 'products')
          || hasModulePermission(companyId, 'dashboard')
          || hasModulePermission(companyId, 'reports')
          || hasModulePermission(companyId, 'sales')
          || hasModulePermission(companyId, 'stockIn')
          || hasModulePermission(companyId, 'stockOut')
          || hasModulePermission(companyId, 'transfers')
          || hasModulePermission(companyId, 'production')
          || hasModulePermission(companyId, 'inventoryAudit')
          || hasModulePermission(companyId, 'cash')
        ))
        || (collectionName == 'warehouses' && (
          hasModulePermission(companyId, 'warehouses')
          || hasModulePermission(companyId, 'reports')
          || hasModulePermission(companyId, 'stockIn')
          || hasModulePermission(companyId, 'stockOut')
          || hasModulePermission(companyId, 'transfers')
          || hasModulePermission(companyId, 'production')
          || hasModulePermission(companyId, 'inventoryAudit')
        ))
        || (collectionName == 'stock-in' && hasModulePermission(companyId, 'stockIn'))
        || (collectionName == 'stock-out' && hasModulePermission(companyId, 'stockOut'))
        || (collectionName == 'transfers' && hasModulePermission(companyId, 'transfers'))
        || (collectionName == 'production' && hasModulePermission(companyId, 'production'))
        || (collectionName == 'recipes' && hasModulePermission(companyId, 'recipes'))
        || (collectionName == 'expenses' && (
          hasModulePermission(companyId, 'expenses')
          || hasModulePermission(companyId, 'reports')
        ))
        || (collectionName in ['employees', 'staff'] && (
          isCompanyAdmin(companyId)
          || hasModulePermission(companyId, 'employees')
          || hasModulePermission(companyId, 'reports')
        ))
        || (collectionName == 'reports' && hasModulePermission(companyId, 'reports'))
        || (collectionName == 'history' && hasModulePermission(companyId, 'history'))
        || (collectionName == 'settings' && hasModulePermission(companyId, 'settings'))
        || (collectionName == 'profile' && hasModulePermission(companyId, 'profile'))
        || (collectionName == 'inventory' && (
          hasModulePermission(companyId, 'inventoryAudit')
          || hasModulePermission(companyId, 'production')
        ))
        || (collectionName == 'inventory-audit' && hasModulePermission(companyId, 'inventoryAudit'))
        || (collectionName == 'auditLogs' && (
          hasModulePermission(companyId, 'history')
          || hasModulePermission(companyId, 'inventoryAudit')
        ))
        || (collectionName == 'sales' && hasModulePermission(companyId, 'sales'))
        || (collectionName == 'cash' && hasModulePermission(companyId, 'cash'))
        || (collectionName == 'stockMovements' && (
          hasModulePermission(companyId, 'dashboard')
          || hasModulePermission(companyId, 'reports')
          || hasModulePermission(companyId, 'stockIn')
          || hasModulePermission(companyId, 'stockOut')
          || hasModulePermission(companyId, 'sales')
          || hasModulePermission(companyId, 'history')
        ));
    }

    function companyRole(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid)).data.role;
    }

    function isCompanyAdmin(companyId) {
      return isActiveCompanyMember(companyId) && companyRole(companyId) == 'Admin';
    }

    function isCompanySeller(companyId) {
      return isActiveCompanyMember(companyId) && companyRole(companyId) == 'Sotuvchi';
    }

    function isCompanyWarehouseWorker(companyId) {
      return isActiveCompanyMember(companyId)
        && companyRole(companyId) in ['Omborchi', "Ombor boshlig'i"];
    }

    function isCompanyCashier(companyId) {
      return isActiveCompanyMember(companyId) && companyRole(companyId) == 'Kassir';
    }

    // ============================================================
    // COMPANIES
    // ============================================================

    match /companies/{companyId} {
      allow read: if isSuperAdmin() || isCompanyMember(companyId);
      allow create, update, delete: if isSuperAdmin();
    }

    // Kompaniya ichidagi kolleksiyalar
    match /companies/{companyId}/{collectionName}/{documentId} {

      allow read: if isSuperAdmin()
        || (hasAuth()
          && collectionName == 'users'
          && documentId == request.auth.uid
          && isCompanyMember(companyId))
        || (isActiveCompanyMember(companyId)
          && canAccessCompanyCollection(companyId, collectionName)
          && (
            !(collectionName in ['expenses', 'employees', 'staff', 'reports', 'history', 'auditLogs', 'accountAuditLogs', 'cash'])
            || isCompanyAdmin(companyId)
            || (collectionName == 'expenses' && hasExplicitModulePermission(companyId, 'expenses'))
            || (collectionName == 'expenses' && hasExplicitModulePermission(companyId, 'reports'))
            || (collectionName in ['employees', 'staff'] && (
              hasExplicitModulePermission(companyId, 'employees')
              || hasExplicitModulePermission(companyId, 'reports')
            ))
            || (collectionName == 'reports' && hasExplicitModulePermission(companyId, 'reports'))
            || (collectionName == 'history' && hasExplicitModulePermission(companyId, 'history'))
            || (collectionName == 'auditLogs' && (
              hasExplicitModulePermission(companyId, 'history')
              || hasExplicitModulePermission(companyId, 'inventoryAudit')
            ))
            || (collectionName == 'cash' && hasExplicitModulePermission(companyId, 'cash'))
          ));

      allow create: if (isSuperAdmin()
          && (
            (collectionName == 'users'
              && request.resource.data.companyId == companyId
              && request.resource.data.role == 'Admin')
            || collectionName in ['payments', 'subscriptions']
          ))
        || (isActiveCompanyMember(companyId)
          && canAccessCompanyCollection(companyId, collectionName)
          && (
            (collectionName == 'users'
              && isCompanyAdmin(companyId)
              && request.resource.data.companyId == companyId
              && request.resource.data.role in ['Admin', 'Sotuvchi', 'Omborchi', 'Kassir', 'Menejer', 'Ishchi', "Ombor boshlig'i", 'Hisobchi'])
            || (collectionName == 'products' && (isCompanyAdmin(companyId) || isCompanySeller(companyId)))
            || (collectionName in ['sales', 'cash'] && (isCompanyAdmin(companyId) || isCompanyCashier(companyId) || isCompanySeller(companyId)))
            || (collectionName in ['stock-out', 'stock-in', 'transfers', 'production', 'inventory']
              && (isCompanyAdmin(companyId) || isCompanyWarehouseWorker(companyId)))
            || (collectionName == 'stockMovements')
            || (collectionName in ['warehouses', 'categories', 'recipes', 'employees', 'staff', 'reports', 'settings', 'counters', 'profile']
              && isCompanyAdmin(companyId))
            || (collectionName == 'expenses' && (isCompanyAdmin(companyId) || isCompanySeller(companyId)))
            || (collectionName in ['auditLogs', 'inventory-audit']
              && (isCompanyAdmin(companyId) || isCompanyWarehouseWorker(companyId)))
            || (collectionName == 'history')
            || (collectionName in ['chats', 'messages'])
          ));

      allow update: if isActiveCompanyMember(companyId)
        && (canAccessCompanyCollection(companyId, collectionName)
          || (collectionName == 'users' && request.auth.uid == documentId))
        && (
          (collectionName == 'users'
            && request.resource.data.companyId == companyId
            && request.resource.data.role != 'Super Admin'
            && (isCompanyAdmin(companyId)
              || (request.auth.uid == documentId
                && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'companyId', 'permissions', 'status']))))
          || (collectionName in ['warehouses', 'categories', 'recipes', 'employees', 'staff', 'reports', 'settings', 'cash', 'counters', 'profile']
            && isCompanyAdmin(companyId))
          || (collectionName == 'products'
            && (isCompanyAdmin(companyId) || isCompanySeller(companyId) || isCompanyCashier(companyId)))
          || (collectionName == 'sales'
            && (isCompanyAdmin(companyId) || isCompanySeller(companyId) || isCompanyCashier(companyId)))
          || (collectionName in ['stock-out', 'stock-in', 'transfers', 'production', 'inventory']
            && (isCompanyAdmin(companyId) || isCompanyWarehouseWorker(companyId)))
          || (collectionName == 'stockMovements')
          || (collectionName == 'expenses' && isCompanyAdmin(companyId))
          || (collectionName in ['auditLogs', 'inventory-audit']
            && (isCompanyAdmin(companyId) || isCompanyWarehouseWorker(companyId)))
          || (collectionName == 'history' && isCompanyAdmin(companyId))
          || (collectionName in ['chats', 'messages'])
        );

      allow delete: if isActiveCompanyMember(companyId)
        && canAccessCompanyCollection(companyId, collectionName)
        && (
          (collectionName == 'users' && isCompanyAdmin(companyId))
          || (collectionName in ['products', 'sales', 'expenses', 'warehouses', 'categories', 'recipes', 'employees', 'staff', 'reports', 'settings', 'cash']
            && isCompanyAdmin(companyId))
          || (collectionName in ['inventory', 'stockMovements', 'inventory-audit', 'auditLogs', 'counters', 'profile', 'history']
            && isCompanyAdmin(companyId))
          || (collectionName in ['chats', 'messages'])
        );
    }

    // ============================================================
    // USERS (global)
    // ============================================================

    match /users/{userId} {
      allow read: if hasAuth();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || request.auth.uid == userId;
      allow delete: if isSuperAdmin();
    }

    // ============================================================
    // ROOT KOLLEKSIYALAR (eski tizim, vaqtinchalik)
    // ============================================================

    match /products/{docId} {
      allow read, write: if hasAuth();
    }

    match /categories/{docId} {
      allow read: if hasAuth();
      allow write: if isSuperAdmin();
    }

    match /recipes/{docId} {
      allow read: if hasAuth();
      allow write: if isSuperAdmin();
    }

    match /warehouses/{docId} {
      allow read: if hasAuth();
      allow write: if isSuperAdmin();
    }

    match /inventory/{docId} {
      allow read, write: if hasAuth();
    }

    match /inventory-audit/{docId} {
      allow read, write: if hasAuth();
    }

    match /stockMovements/{docId} {
      allow read, write: if hasAuth();
    }

    match /stock-in/{docId} {
      allow read, write: if hasAuth();
    }

    match /stock-out/{docId} {
      allow read, write: if hasAuth();
    }

    match /transfers/{docId} {
      allow read, write: if hasAuth();
    }

    match /production/{docId} {
      allow read, write: if hasAuth();
    }

    match /sales/{docId} {
      allow read, write: if hasAuth();
    }

    match /expenses/{docId} {
      allow read, write: if hasAuth();
    }

    match /cash/{docId} {
      allow read, write: if hasAuth();
    }

    match /employees/{docId} {
      allow read, write: if hasAuth();
    }

    match /staff/{docId} {
      allow read, write: if hasAuth();
    }

    match /reports/{docId} {
      allow read, write: if hasAuth();
    }

    match /history/{docId} {
      allow read, write: if hasAuth();
    }

    match /auditLogs/{docId} {
      allow read, write: if hasAuth();
    }

    match /settings/{docId} {
      allow read, write: if hasAuth();
    }

    match /counters/{docId} {
      allow read, write: if hasAuth();
    }

    match /profile/{userId} {
      allow read, write: if hasAuth();
    }

    match /chats/{docId} {
      allow read, write: if hasAuth();
    }

    match /messages/{docId} {
      allow read, write: if hasAuth();
    }

    // ============================================================
    // BOSHQA HAMMA NARSA: faqat super admin
    // ============================================================

    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
