rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // SUPER ADMIN
    // ============================================================

    function isSuperAdmin() {
      return request.auth != null
        && request.auth.token.email == 'f2472839@gmail.com';
    }


    // ============================================================
    // LOGIN QILGAN FOYDALANUVCHI
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }


    // ============================================================
    // ADMIN / SUPER ADMIN
    // ============================================================

    function isAdmin() {
      return isSuperAdmin()
        ||
        (
          isSignedIn()
          &&
          (
            exists(
              /databases/$(database)/documents/rolesAdmin/$(request.auth.uid)
            )
            ||
            (
              exists(
                /databases/$(database)/documents/users/$(request.auth.uid)
              )
              &&
              get(
                /databases/$(database)/documents/users/$(request.auth.uid)
              ).data.role in [
                'Admin',
                'Super Admin',
                'SUPER_ADMIN'
              ]
            )
          )
        );
    }


    // ============================================================
    // SUPER ADMIN — BARCHA FIRESTORE UCHUN TO'LIQ HUQUQ
    // ============================================================
    //
    // f2472839@gmail.com:
    //
    // READ     ✅
    // CREATE   ✅
    // UPDATE   ✅
    // DELETE   ✅
    //
    // Yangi collectionlar ham avtomatik ishlaydi.
    //

    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }


    // ============================================================
    // USERS
    // ============================================================

    match /users/{userId} {

      allow read: if isSignedIn();

      allow create: if isAdmin();

      allow update: if isAdmin()
                    || request.auth.uid == userId;

      allow delete: if isAdmin();
    }


    // ============================================================
    // ADMIN ROLES
    // ============================================================

    match /rolesAdmin/{userId} {

      allow read: if isSignedIn();

      allow create, update, delete: if isAdmin();
    }


    // ============================================================
    // OMBORLAR
    // ============================================================

    match /warehouses/{warehouseId} {

      allow read: if isSignedIn();

      allow create, update, delete: if isAdmin();
    }


    // ============================================================
    // KATEGORIYALAR
    // ============================================================

    match /categories/{categoryId} {

      allow read: if isSignedIn();

      allow create, update, delete: if isAdmin();
    }


    // ============================================================
    // MAHSULOTLAR
    // ============================================================

    match /products/{productId} {

      allow read: if isSignedIn();

      allow create, update, delete: if isAdmin();
    }


    // ============================================================
    // ISHCHILAR
    // ============================================================

    match /employees/{employeeId} {

      allow read: if isSignedIn();

      allow create, update, delete: if isAdmin();
    }


    // ============================================================
    // XARAJATLAR
    // ============================================================

    match /expenses/{expenseId} {

      allow read: if isSignedIn();

      allow create: if isSignedIn();

      allow update, delete: if isAdmin();
    }


    // ============================================================
    // STOCK MOVEMENTS / AUDIT TRAIL
    // ============================================================

    match /stockMovements/{movementId} {

      allow read: if isSignedIn();

      allow create: if isSignedIn();

      allow update, delete: if isAdmin();
    }


    // ============================================================
    // INVENTORY
    // ============================================================

    match /inventory/{inventoryId} {

      allow read: if isSignedIn();

      allow create, update: if isSignedIn();

      allow delete: if isAdmin();
    }


    // ============================================================
    // NAKLADNOY / HUJJATLAR
    // ============================================================

    match /documents/{documentId} {

      allow read: if isSignedIn();

      allow create, update: if isSignedIn();

      allow delete: if isAdmin();
    }


    // ============================================================
    // SAVDOLAR
    // ============================================================

    match /sales/{saleId} {

      allow read: if isSignedIn();

      allow create: if isSignedIn();

      allow update, delete: if isAdmin();
    }

  }
}
